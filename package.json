{
  "name": "drone-avionics-3d-editor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build:viewer": "esbuild src/standaloneViewer/viewerEngine.ts --bundle --minify --format=iife --target=es2020 --outfile=public/viewer-engine.min.js",
    "build": "npm run build:viewer && tsc -b && vite build",
    "lint": "tsc -b",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "firebase": "^12.18.0",
    "jszip": "^3.10.1",
    "lucide-react": "^1.38.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.180.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  },
  "devDependencies": {
    "@types/jszip": "^3.4.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.180.0",
    "esbuild": "^0.28.2"
  }
}
